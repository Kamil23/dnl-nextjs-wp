# WPGraphQL endpoint of the (legacy) WordPress site - used by the app until
# the DB migration is complete, and by scripts/import-wp.ts
WORDPRESS_API_URL=https://dietanaluzie.pl/graphql

# Postgres (local dev: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgres://dnl:dnl@localhost:5433/dietanaluzie

# Admin panel
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-hex

# TikTok worker - jeden klucz AI wystarczy (priorytet w tej kolejności):
# OpenAI: vision + transkrypcja Whisper jednym kluczem (model: OPENAI_MODEL, domyślnie gpt-4o)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna   # tani i szybki: draft z wideo i przypisanie klatek
# Mocniejszy model do dopełniania braków i liczenia wartości odżywczych
# (domyślnie gpt-6-sol). Oba przestawisz też w /admin/tiktok -> Ustawienia AI.
# OPENAI_STRONG_MODEL=gpt-6-sol
# Najtańszy model do klasyfikacji opisów w backlogu TikTok (domyślnie gpt-4o-mini)
# OPENAI_CHEAP_MODEL=gpt-4o-mini
# Gemini (darmowy tier, rozumie audio): klucz z aistudio.google.com
# GEMINI_API_KEY=
# Claude
# ANTHROPIC_API_KEY=
# Dowolne API zgodne z OpenAI (Kimi/Moonshot, OpenRouter - model musi mieć vision)
# AI_COMPAT_BASE_URL=
# AI_COMPAT_API_KEY=
# AI_COMPAT_MODEL=
# Poprawa zdjęcia głównego (usuwanie rozmycia z klatki wideo): na żądanie, przycisk
# "Generuj AI hero" w /admin/tiktok; GEMINI_API_KEY (preferowane, tanio) albo OPENAI_API_KEY (gpt-image-1)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Meilisearch (wyszukiwarka z tolerancja literowek)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me

GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY_PATH=

# Newsletter (Resend wysyła, lista mieszka w naszym Postgresie)
RESEND_API_KEY=
# NEWSLETTER_FROM=Roksana | Dieta na luzie <roksana@dietanaluzie.pl>
# Sekret webhooka Resend (svix, whsec_...) - tracking otwarc/klikniec/odbic.
# resend.com -> Webhooks -> endpoint https://<host>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# IndexNow: ping Bing/Yandex przy publikacji przepisu (Google nie wspiera).
# Puste = wyłączone (dev). Generacja: openssl rand -hex 16
INDEXNOW_KEY=

# Cloudflare Turnstile: antybot na formularzu newslettera w stopce.
# Puste = wyłączone (dev). Klucze: dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
