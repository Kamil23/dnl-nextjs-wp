# Reverse proxy + automatic HTTPS for the primary domain. WordPress is retired:
# the legacy /wp-content/uploads/* media (and TikTok import frames under
# /uploads/*) are self-hosted and served straight from disk by Caddy, before
# anything reaches the Next app. Media lives in /srv/media (bind-mounted from
# the host, see docker-compose.yml). Everything else proxies to the app.
{
	# email for Let's Encrypt expiry notices (optional but recommended)
	email admin@{$SITE_DOMAIN:dietanaluzie.pl}
}

{$SITE_DOMAIN:dietanaluzie.pl} {
	# Server-side traffic truth: consent-independent access log (stays on our
	# box, GDPR-fine). GA undercounts by design since the cookie banner - this
	# is the objective baseline. Analyze: see DEPLOY.md "Ruch server-side".
	log {
		output file /data/access/access.log {
			roll_size 50mb
			roll_keep 7
		}
		format json
	}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS - only enable once you are sure HTTPS is stable
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Legacy WordPress media (Google Images traffic) - served from disk, 1:1 URLs
	handle /wp-content/uploads/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# TikTok import frames + any new self-hosted media
	handle /uploads/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Lead-magnet PDFs (newsletter welcome mails link here); no immutable -
	# the files get re-printed when recipes change
	handle /pobrane/* {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else → the Next app
	handle {
		reverse_proxy web:3000
	}
}

# Canonical host is the apex (matches the live site's canonical). Send www → apex.
www.{$SITE_DOMAIN:dietanaluzie.pl} {
	redir https://{$SITE_DOMAIN:dietanaluzie.pl}{uri} permanent
}
