# ─── Production environment (Hetzner VPS) ────────────────────────────────────
# Copy to `.env` on the server (docker compose auto-loads it) and fill in.
# `.env` is gitignored — never commit real secrets.

# ── Domain ───────────────────────────────────────────────────────────────────
# The public apex the app is served from. Caddy issues TLS for this + www.
SITE_DOMAIN=dietanaluzie.pl
# Full origin of the app. next.config uses it to (a) allow next/image to load
# the legacy /wp-content images (absolute URLs on this host) and (b) REFUSE to
# build if the media proxy would loop back onto this host.
APP_ORIGIN=https://dietanaluzie.pl

# ── WordPress media origin — THE cutover-critical value ──────────────────────
# MUST point at the WordPress SUBDOMAIN, never the apex. The app proxies
# /wp-content/uploads/* here; if this equals APP_ORIGIN the build aborts (loop
# guard) and all legacy images would 404. Move WP to wp.dietanaluzie.pl first.
WORDPRESS_API_URL=https://wp.dietanaluzie.pl/graphql

# ── Postgres (runs in compose) ───────────────────────────────────────────────
POSTGRES_USER=dnl
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=dietanaluzie

# ── Meilisearch (runs in compose) ────────────────────────────────────────────
# Generate: openssl rand -hex 32
MEILI_MASTER_KEY=change-me-long-random-hex

# ── Admin panel ──────────────────────────────────────────────────────────────
# ROTATE before launch — do NOT ship the dev password.
ADMIN_PASSWORD=change-me-strong-admin-password
# Signs the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SECRET=change-me-long-random-hex

# ── TikTok import worker (optional; only if you run imports on the server) ────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# ── Analytics (optional; server-side GA4 for "Hity czytelników") ─────────────
GA4_PROPERTY_ID=
# Path INSIDE the container. Mount the key file into the tools/web service if used.
GA4_SERVICE_ACCOUNT_KEY_PATH=
