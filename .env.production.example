# ─── Production environment (Hetzner VPS) ────────────────────────────────────
# Copy to `.env` on the server (docker compose auto-loads it) and fill in.
# `.env` is gitignored - never commit real secrets.

# ── Domain ───────────────────────────────────────────────────────────────────
# The public apex the app is served from. Caddy issues TLS for this + www.
SITE_DOMAIN=dietanaluzie.pl
# Full origin of the app. next.config uses it to allow next/image to load the
# legacy /wp-content images (stored as absolute URLs on this host).
APP_ORIGIN=https://dietanaluzie.pl

# ── Self-hosted media ────────────────────────────────────────────────────────
# WordPress is retired. All media lives on THIS box. Host directory holding the
# legacy WordPress uploads (wp-content/uploads/...) and new TikTok frames
# (uploads/imports/...). Caddy serves it directly; the tools worker writes new
# frames here. Must survive app rebuilds → keep it OUTSIDE the repo. Back it up.
MEDIA_DIR=/srv/dnl/media
# Where DB dumps + media tarballs land (admin "Backupy" + the 3-day cron write
# here). Create it owned by the container user: mkdir -p + chown 1001:1001.
BACKUP_DIR=/srv/dnl/backups

# ── WordPress (retired) ──────────────────────────────────────────────────────
# The running app NO LONGER needs WordPress. This is only used by the one-off
# import script (npm run import:wp) IF you ever re-import from a still-live WP.
# Leave blank in normal operation.
WORDPRESS_API_URL=

# ── Postgres (runs in compose) ───────────────────────────────────────────────
POSTGRES_USER=dnl
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=dietanaluzie

# ── Meilisearch (runs in compose) ────────────────────────────────────────────
# Generate: openssl rand -hex 32
MEILI_MASTER_KEY=change-me-long-random-hex

# ── Admin panel ──────────────────────────────────────────────────────────────
# ROTATE before launch - do NOT ship the dev password.
ADMIN_PASSWORD=change-me-strong-admin-password
# Signs the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SECRET=change-me-long-random-hex

# ── Newsletter (Resend delivers, the list lives in our Postgres) ─────────────
# Key from resend.com after verifying the dietanaluzie.pl domain (DKIM/SPF DNS).
RESEND_API_KEY=
# NEWSLETTER_FROM=Roksana | Dieta na luzie <roksana@dietanaluzie.pl>
# Cloudflare Turnstile (antybot na formularzu w stopce; puste = wyłączone).
# Site key trafia do bundla przy BUILDZIE web - ustaw PRZED `docker compose build web`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── TikTok import worker (the `worker` compose service polls the queue) ──────
# One AI key is enough; without any key the worker idles and imports stay
# "W kolejce". OPENAI covers vision + Whisper with a single key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Analytics (optional; server-side GA4 for "Hity czytelników") ─────────────
GA4_PROPERTY_ID=
# Path INSIDE the container. Mount the key file into the tools/web service if used.
GA4_SERVICE_ACCOUNT_KEY_PATH=
